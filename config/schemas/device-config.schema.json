{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pet.local/schemas/device-config.schema.json",
  "title": "DeviceConfig",
  "description": "设备运行期用户配置（NVS pet_cfg），不含凭据。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "timezone", "language", "volume", "brightness", "dnd", "message"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "default": "Asia/Shanghai",
      "pattern": "^(Asia/Shanghai|UTC|Etc/UTC|UTC[+-][0-9]{2}:[0-9]{2})$",
      "description": "固定时区：Asia/Shanghai、UTC、Etc/UTC 或 UTC+HH:MM/UTC-HH:MM；偏移 -12:00 至 +14:00，不处理夏令时。"
    },
    "language": {
      "description": "v1 reserves en-US; current PET04 firmware supports zh-CN and rejects unsupported runtime locales.",
      "type": "string",
      "enum": ["zh-CN", "en-US"],
      "default": "zh-CN"
    },
    "volume": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 25
    },
    "brightness": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 80
    },
    "muted": {
      "type": "boolean",
      "default": false,
      "description": "独立语音静音，重启后保留；不受定时免打扰结束影响。"
    },
    "dnd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "startMinute", "endMinute", "allowCritical"],
      "properties": {
        "manual": {
          "type": "boolean",
          "default": false,
          "description": "手动免打扰，独立于定时规则。"
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "startMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439,
          "default": 1320,
          "description": "本地时间分钟数，1320 = 22:00"
        },
        "endMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439,
          "default": 420,
          "description": "本地时间分钟数，420 = 07:00"
        },
        "allowCritical": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutS", "idleBrightness"],
      "description": "屏幕节能：两段亮度（交互亮度 brightness / 待机亮度 idleBrightness）+ 息屏超时。",
      "properties": {
        "timeoutS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600,
          "default": 60,
          "description": "无输入/语音/消息事件达到该秒数后关背光；0=永不息屏。"
        },
        "idleBrightness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 40,
          "description": "静置 30 秒后降至的待机亮度（不高于交互亮度时生效）。"
        }
      }
    },
    "sfxVolume": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 25,
      "description": "消息提示音音量，与 TTS 人声 volume 分离；旧存档缺失时沿用 volume。"
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queueDepth", "durationMs"],
      "properties": {
        "queueDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 8
        },
        "durationMs": {
          "type": "integer",
          "minimum": 5000,
          "maximum": 30000,
          "default": 8000
        }
      }
    }
  }
}
