{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pet.local/contracts/device-management-v1/ConfigResult.schema.json",
  "title": "PetConfigResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "status",
    "revision",
    "code"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{0,40}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "applied",
        "rejected",
        "expired",
        "conflict_or_storage"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "code": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    }
  },
  "description": "QoS1, non-retained. Topic supplies the ACL-protected device identity. Empty requestId is an uncorrelatable parse failure; only code=0 and applied confirms the settings transaction."
}
