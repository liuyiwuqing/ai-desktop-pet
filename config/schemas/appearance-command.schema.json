{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "deviceId",
    "requestId",
    "expectedRevision",
    "issuedAt",
    "expiresAt",
    "appearance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogVersion": {
      "const": 1
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,40}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967294
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme",
        "outfit",
        "slots"
      ],
      "properties": {
        "theme": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "outfit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [
              0,
              7,
              8,
              9,
              10,
              11,
              12
            ]
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    }
  },
  "title": "PetAppearanceCommand"
}
