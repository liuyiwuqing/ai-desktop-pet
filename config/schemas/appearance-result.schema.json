{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "status",
    "appearanceRevision",
    "code"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "maxLength": 36
    },
    "status": {
      "enum": [
        "applied",
        "rejected",
        "expired",
        "conflict",
        "storage_error",
        "unconfirmed"
      ]
    },
    "appearanceRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    }
  },
  "title": "PetAppearanceResult"
}
