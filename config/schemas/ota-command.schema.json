{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pet.local/contracts/remote-ota-v1/PetOtaCommand.schema.json",
  "title": "PetOtaCommand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deviceId",
    "requestId",
    "commandId",
    "operation",
    "bootId",
    "issuedAt",
    "expiresAt",
    "target"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-zA-Z0-9_-]*$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-zA-Z0-9_-]*$"
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-zA-Z0-9_-]*$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "install",
        "reboot"
      ]
    },
    "bootId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[0-9a-f]{32}$"
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "version",
        "imageSha256",
        "imageSize",
        "releaseSequence"
      ],
      "properties": {
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "imageSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "imageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "releaseSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    }
  }
}
