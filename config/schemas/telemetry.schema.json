{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pet.local/contracts/pet-management-v1/Telemetry.schema.json",
  "title": "PetTelemetry",
  "description": "PET04 management extension; QoS1 retained telemetry. No credentials, transcripts or private message contents. Existing nexus-core state remains unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deviceId",
    "observedAt",
    "firmwareVersion",
    "configRevision",
    "configWritable",
    "muted",
    "dnd",
    "volume",
    "brightness",
    "unread",
    "freeHeap",
    "minFreeHeap"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,40}$"
    },
    "observedAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "firmwareVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "configRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "configWritable": {
      "type": "boolean"
    },
    "muted": {
      "type": "boolean"
    },
    "dnd": {
      "type": "boolean"
    },
    "volume": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "brightness": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "unread": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "freeHeap": {
      "type": "integer",
      "minimum": 0
    },
    "minFreeHeap": {
      "type": "integer",
      "minimum": 0
    },
    "audioUnderruns": {
      "type": "integer",
      "minimum": 0
    },
    "inferenceMaxMs": {
      "type": "integer",
      "minimum": 0
    },
    "displayMaxMs": {
      "type": "integer",
      "minimum": 0
    },
    "audioFaulted": {
      "type": "boolean"
    },
    "wifiIp": {
      "description": "本机 Wi-Fi IPv4 点分十进制；未关联或未取得地址时省略。不含 SSID 或凭据。",
      "type": "string",
      "maxLength": 15,
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
    },
    "wifiRssi": {
      "description": "当前 AP 的 RSSI（dBm，<=0）；未关联或取不到时省略。",
      "type": "integer",
      "minimum": -130,
      "maximum": 0
    },
    "wifiSsid": {
      "description": "当前 AP 的 SSID（UTF-8，最多 32 字节）；未关联、取不到或空口字节不是可打印 UTF-8 时省略。不含口令。",
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "wifiChannel": {
      "description": "当前 AP 的主信道（1–196）；未关联或取不到时省略。",
      "type": "integer",
      "minimum": 1,
      "maximum": 196
    },
    "wifiBssid": {
      "description": "当前 AP 的 BSSID（大写十六进制 AA:BB:CC:DD:EE:FF）；未关联或取不到时省略。仅用于识别接入点，不含口令。",
      "type": "string",
      "maxLength": 17,
      "pattern": "^([0-9A-F]{2}:){5}[0-9A-F]{2}$"
    },
    "wifiChannelWidth": {
      "description": "当前 AP 的信道宽度（MHz），20 或 40；未关联或取不到时省略。",
      "type": "integer",
      "enum": [20, 40]
    },
    "wifiDisconnectReason": {
      "description": "本次启动以来最近一次 Wi-Fi 断线原因（ESP-IDF wifi_err_reason_t）；从未断线时省略。",
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "wifiDisconnectedAt": {
      "description": "最近一次断线的设备时间（Unix 秒）；未对时或从未断线时省略。",
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "config": {
      "description": "设备运行期用户配置（NVS pet_cfg），不含凭据。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "timezone",
        "language",
        "volume",
        "brightness",
        "dnd",
        "message"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "default": "Asia/Shanghai",
          "pattern": "^(Asia/Shanghai|UTC|Etc/UTC|UTC[+-][0-9]{2}:[0-9]{2})$",
          "description": "固定时区：Asia/Shanghai、UTC、Etc/UTC 或 UTC+HH:MM/UTC-HH:MM；偏移 -12:00 至 +14:00，不处理夏令时。"
        },
        "language": {
          "description": "v1 reserves en-US; current PET04 firmware supports zh-CN and rejects unsupported runtime locales.",
          "type": "string",
          "enum": [
            "zh-CN",
            "en-US"
          ],
          "default": "zh-CN"
        },
        "volume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 25
        },
        "brightness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 80
        },
        "muted": {
          "type": "boolean",
          "default": false,
          "description": "独立语音静音，重启后保留；不受定时免打扰结束影响。"
        },
        "dnd": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "startMinute",
            "endMinute",
            "allowCritical"
          ],
          "properties": {
            "manual": {
              "type": "boolean",
              "default": false,
              "description": "手动免打扰，独立于定时规则。"
            },
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "startMinute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1439,
              "default": 1320,
              "description": "本地时间分钟数，1320 = 22:00"
            },
            "endMinute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1439,
              "default": 420,
              "description": "本地时间分钟数，420 = 07:00"
            },
            "allowCritical": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "message": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queueDepth",
            "durationMs"
          ],
          "properties": {
            "queueDepth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "default": 8
            },
            "durationMs": {
              "type": "integer",
              "minimum": 5000,
              "maximum": 30000,
              "default": 8000
            }
          }
        }
      }
    }
  }
}
