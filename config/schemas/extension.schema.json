{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pet.local/schemas/extension.schema.json",
  "title": "ExtensionManifest",
  "description": "扩展包清单 extensions/<name>/extension.json；声明契约版本、能力与最高风险。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "contractVersion",
    "capabilities",
    "risk",
    "defaultEnabled",
    "description"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,31}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "contractVersion": {
      "type": "integer",
      "minimum": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      }
    },
    "risk": {
      "type": "string",
      "enum": ["l0_read", "l1_reversible", "l2_destructive", "l3_critical"]
    },
    "defaultEnabled": {
      "type": "boolean",
      "const": false
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    }
  }
}
