{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pet.local/contracts/remote-ota-v1/PetOtaStatus.schema.json",
  "title": "PetOtaStatus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deviceId",
    "observedAt",
    "reportSequence",
    "bootId",
    "available",
    "state",
    "code",
    "requestId",
    "rebootId",
    "writtenBytes",
    "reservedSequence",
    "identity"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-zA-Z0-9_-]*$"
    },
    "observedAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "reportSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "bootId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[0-9a-f]{32}$"
    },
    "available": {
      "type": "boolean"
    },
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "installing",
        "pending_reboot",
        "reboot_requested",
        "verifying",
        "healthy",
        "failed",
        "interrupted",
        "rolled_back",
        "unconfirmed",
        "unavailable"
      ]
    },
    "code": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "requestId": {
      "type": "string",
      "minLength": 0,
      "maxLength": 40,
      "pattern": "^[a-zA-Z0-9_-]*$"
    },
    "rebootId": {
      "type": "string",
      "minLength": 0,
      "maxLength": 40,
      "pattern": "^[a-zA-Z0-9_-]*$"
    },
    "writtenBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4194304
    },
    "reservedSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "board",
        "modelSha256",
        "partitionSha256",
        "configSchema",
        "growthSchema"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_-]*$"
        },
        "board": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_-]*$"
        },
        "modelSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(none|[0-9a-f]{64})$"
        },
        "partitionSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "configSchema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "growthSchema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "version",
        "imageSha256",
        "imageSize",
        "releaseSequence"
      ],
      "properties": {
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "imageSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "imageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "releaseSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    }
  }
}
