# 复制到 /etc/nexus/core.env 后 chmod 600；保留空值直到填写真实凭据。
# 本文件给 JAR/systemd 使用，不支持 run_local.py 的 CONFIG_FILE 引用。
NEXUS_BIND_ADDRESS=127.0.0.1
NEXUS_PORT=8088
NEXUS_DB_URL=jdbc:postgresql://127.0.0.1:54329/nexus
NEXUS_DB_USER=nexus
NEXUS_DB_PASSWORD=
NEXUS_ADMIN_TOKEN=
NEXUS_MQTT_URI=ssl://mqtt.example.invalid:8883
NEXUS_MQTT_USERNAME=nexus-core
NEXUS_MQTT_PASSWORD=
NEXUS_MQTT_CLIENT_ID=nexus-core
NEXUS_MQTT_ALLOW_INSECURE=false
NEXUS_MQTT_CA_CERT=/etc/nexus/mqtt-ca.crt
NEXUS_HALO_ENABLED=false
NEXUS_AI_ENABLED=false
NEXUS_AI_AUTO_ENABLED=false
NEXUS_MEMORY_ENABLED=false
# Separate, machine-only capability for /mcp/memory; never reuse the admin token.
NEXUS_MEMORY_MCP_ENABLED=false
NEXUS_MEMORY_MCP_TOKEN=
NEXUS_BRIDGE_ENABLED=false

# Opt in only after database backup and authenticated retention preview.
NEXUS_RETENTION_ENABLED=false
# NEXUS_RETENTION_CRON=-
