{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pet.local/schemas/message-ack.schema.json",
  "title": "MessageAck",
  "description": "设备回执（MQTT nexus/v1/devices/{deviceId}/ack）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageId", "state", "at", "queueDepth"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "messageId": {
      "type": "string",
      "pattern": "^msg_[A-Za-z0-9]{6,40}$"
    },
    "state": {
      "type": "string",
      "enum": ["received", "displayed", "read"]
    },
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "queueDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    }
  }
}
