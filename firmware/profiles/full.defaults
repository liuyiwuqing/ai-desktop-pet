# Compile every software adapter. Credentials are provisioned separately.
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_PET_MODULE_CLIMATE_ENABLED=y
CONFIG_PET_PROVISION_CONSOLE_ENABLED=y
CONFIG_PET_AI_XIAOZHI_ON_BOOT=y
CONFIG_PET_AI_ESP_SR_ENABLED=y
CONFIG_PET_AI_DSP_ENABLED=y
CONFIG_PET_AI_AEC_REFERENCE_ENABLED=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_XIAOAITONGXUE=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_PET_EXT_DEVICE_CONTROL=y
CONFIG_PET_EXT_SERVO=y
CONFIG_PET_EXT_JOYSTICK=y
CONFIG_PET_SERVO_GPIO=-1
CONFIG_PET_OTA_ENABLED=y
CONFIG_PET_OTA_REMOTE_ENABLED=y
CONFIG_PET_GROWTH_SYNC_ENABLED=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
