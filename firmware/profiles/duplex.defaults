# Explicit boot diagnostic only; normal AI/tone owners stay disabled.
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_PET_MODULE_AUDIO_ENABLED=y
# CONFIG_PET_MODULE_AI_ENABLED is not set
# CONFIG_PET_AUDIO_FAKE is not set
CONFIG_PET_AUDIO_DIAGNOSTIC_ON_BOOT=y
CONFIG_PET_AUDIO_DIAGNOSTIC_DUPLEX=y
# CONFIG_PET_AUDIO_DIAGNOSTIC_LOOPBACK is not set
