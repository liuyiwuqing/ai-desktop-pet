# Base hardware + local "小爱同学" wake/VAD; provision credentials separately.
CONFIG_APP_REPRODUCIBLE_BUILD=y
# WakeNet uses many small buffers; leave internal RAM for LCD/I2S/Wi-Fi/DMA.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
# WakeNet and LVGL share the S3 caches; keep instruction working sets resident.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_PET_AI_XIAOZHI_ON_BOOT=y
CONFIG_PET_AI_ESP_SR_ENABLED=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_XIAOAITONGXUE=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_PET_PROVISION_CONSOLE_ENABLED=y
CONFIG_PET_RECOVERY_ENABLED=y
# CONFIG_PET_AI_DSP_ENABLED is not set
# CONFIG_PET_MODULE_CLIMATE_ENABLED is not set
# CONFIG_PET_EXT_DEVICE_CONTROL is not set
# CONFIG_PET_EXT_SERVO is not set
# CONFIG_PET_EXT_JOYSTICK is not set
# CONFIG_PET_EXT_LIGHT_SENSOR is not set
# CONFIG_PET_OTA_ENABLED is not set
