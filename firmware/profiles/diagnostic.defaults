# Sensitive crash stacks remain in the reserved flash partition; never upload automatically.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=4
CONFIG_ESP_COREDUMP_STACK_SIZE=2048
# CONFIG_ESP_COREDUMP_CAPTURE_DRAM is not set
CONFIG_PET_PROVISION_CONSOLE_ENABLED=y
CONFIG_PET_RECOVERY_ENABLED=y
